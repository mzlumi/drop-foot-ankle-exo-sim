# Healthy gait at about 1.2 m/s with the simulated shank gyroscope (Part D).
# Same as healthy.scone, with a measuring ScriptController next to the reflex
# controller. Derived from scone-core scenarios/Tutorials/Tutorial 4a - Gait.scone
# and Tutorial 6b - Script - Balance Device.scone
# (commit 8cc814822c58356e110027d80962ebf0f024e116, Apache-2.0).
# Evaluate a healthy .par in it; set the duration on the command line
# (CmaOptimizer.SimulationObjective.max_duration=60) to get 50 or more strides.
CmaOptimizer {
	signature_prefix = DATE_TIME
	init_file = ../data/raw/scone-tutorials/data/ResultGait10.par

	SimulationObjective {
		max_duration = 10

		ModelOpenSim3 {
			model_file = ../data/raw/scone-tutorials/data/Human0914.osim
			state_init_file = ../data/raw/scone-tutorials/data/InitStateGait10.sto
			initial_state_offset = 0~0.01<-0.5,0.5>
			initial_state_offset_exclude = "*_tx;*_ty;*_u"
		}

		CompositeController {
			# Geyer and Herr (2010) reflex controller, symmetric
			<< ../data/raw/scone-tutorials/data/ControllerGH2010.scone >>

			ScriptController {
				name = IMU
				script_file = "lua/imu.lua"
				body = tibia_r
				rate_hz = 100
				noise_dps = 0.5
				bias_dps = 2
				imu_delay_s = 0.015
				seed = 1
			}
		}

		<< include/MeasureGait12.scone >>
	}
}
