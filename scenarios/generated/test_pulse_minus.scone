# Device pulse test: healthy model, -2 N m from 2.25 to 2.3 s (analysis/device_check.py).
# Derived from scone-core scenarios/Tutorials/Tutorial 4a - Gait.scone,
# Tutorial 5a - Pathological Gait - Weak Plantarflexors.scone and
# Tutorial 6b - Script - Balance Device.scone
# (commit 8cc814822c58356e110027d80962ebf0f024e116, Apache-2.0).
# Changes: paths point at data/raw/scone-tutorials, external forces enabled,
# the reflex controller runs next to the exoskeleton script
# (scenarios/lua/device.lua), and the gait measure is MeasureGait12.
# Written by dropfoot.scenarios.device_scenario; edit the template, not this file.
CmaOptimizer {
	signature_prefix = DATE_TIME
	init_file = ../../data/raw/scone-tutorials/data/ResultGait10.par

	SimulationObjective {
		max_duration = 10
		signature_postfix = pulse_minus

		ModelOpenSim3 {
			model_file = ../../data/raw/scone-tutorials/data/Human0914.osim
			state_init_file = ../../data/raw/scone-tutorials/data/InitStateGait10.sto
			initial_state_offset = 0~0.01<-0.5,0.5>
			initial_state_offset_exclude = "*_tx;*_ty;*_u"
			enable_external_forces = 1
		}

		CompositeController {
			# Geyer and Herr (2010) reflex controller, symmetric
			<< ../../data/raw/scone-tutorials/data/ControllerGH2010.scone >>

			ScriptController {
				name = Exo
				script_file = "../lua/device.lua"
				mode = constant
				constant_nm = -2.0
				on_time = 2.25
				off_time = 2.3
			}
		}

		<< ../include/MeasureGait12.scone >>
	}
}
